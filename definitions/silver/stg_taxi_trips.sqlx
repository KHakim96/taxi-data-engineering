config {
  type: "table",
  schema: "silver",
  name: "stg_taxi_trips",
  description: "Cleaned and standardized Chicago Taxi Trips"
}

WITH deduplicated AS (

  SELECT *
  FROM ${ref("raw_taxi_trips")}

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY unique_key
    ORDER BY trip_start_timestamp
  ) = 1

),

localized AS (

  SELECT
    *,
    DATETIME(trip_start_timestamp, "America/Chicago") AS trip_start_datetime,
    DATETIME(trip_end_timestamp, "America/Chicago") AS trip_end_datetime
  FROM deduplicated

)

SELECT

  unique_key,
  taxi_id,

  trip_start_timestamp,
  trip_end_timestamp,

  trip_start_datetime,
  trip_end_datetime,

  DATE(trip_start_datetime) AS trip_date,

  EXTRACT(YEAR FROM trip_start_datetime) AS trip_year,
  EXTRACT(MONTH FROM trip_start_datetime) AS trip_month,
  EXTRACT(DAY FROM trip_start_datetime) AS trip_day,
  EXTRACT(DAYOFWEEK FROM trip_start_datetime) AS trip_day_of_week,
  EXTRACT(HOUR FROM trip_start_datetime) AS trip_hour,

  trip_seconds,
  trip_miles,

  fare,
  tips,
  tolls,
  extras,
  trip_total,

  payment_type,

  COALESCE(company, 'Unknown') AS company,

  COALESCE(company, 'Unknown') AS company,

  CASE
    WHEN taxi_id IS NULL THEN 'Unknown Taxi'

    ELSE CONCAT(
      COALESCE(company, 'Unknown'),
      ' - Taxi ',
      LPAD(
        CAST(
          DENSE_RANK() OVER (
            PARTITION BY COALESCE(company, 'Unknown')
            ORDER BY taxi_id
          ) AS STRING
        ),
        4,
        '0'
      )
    )
  END AS taxi_label,

  pickup_census_tract,
  dropoff_census_tract,

  pickup_community_area,
  dropoff_community_area,

  pickup_latitude,
  pickup_longitude,
  pickup_location,

  dropoff_latitude,
  dropoff_longitude,
  dropoff_location

FROM localized

WHERE trip_start_timestamp IS NOT NULL
  AND trip_end_timestamp IS NOT NULL
  AND trip_end_timestamp >= trip_start_timestamp

  -- Remove corrupted records
  AND trip_seconds IS NOT NULL

  -- Remove impossible trips (>24 hours)
  AND TIMESTAMP_DIFF(
        trip_end_timestamp,
        trip_start_timestamp,
        HOUR
      ) <= 24