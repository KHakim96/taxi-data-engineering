config {
  type: "table",
  schema: "silver",
  name: "stg_taxi_trips",
  description: "Cleaned and standardized Chicago Taxi Trips"
}

WITH deduplicated AS (

  SELECT *
  FROM ${ref("raw_taxi_trips")}

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY unique_key
    ORDER BY trip_start_timestamp
  ) = 1

),

localized AS (

  SELECT
    *,
    DATETIME(trip_start_timestamp, "America/Chicago") AS trip_start_datetime,
    DATETIME(trip_end_timestamp, "America/Chicago") AS trip_end_datetime
  FROM deduplicated

)

SELECT

  unique_key,
  taxi_id,

  trip_start_timestamp,
  trip_end_timestamp,

  trip_start_datetime,
  trip_end_datetime,

  -- Exact end reconstructed from trip_seconds in Chicago-local wall-clock time.
  -- Source timestamps are rounded to the nearest 15 minutes (Chicago Data Portal),
  -- so interval math in Gold uses this exact reconstruction, not trip_end_datetime.
  -- Wall-clock arithmetic: DST transition days are 23/25 hours (documented limitation).
  DATETIME_ADD(
    trip_start_datetime,
    INTERVAL trip_seconds SECOND
  ) AS trip_end_datetime_exact,

  DATE(trip_start_datetime) AS trip_date,

  EXTRACT(YEAR FROM trip_start_datetime) AS trip_year,
  EXTRACT(MONTH FROM trip_start_datetime) AS trip_month,
  EXTRACT(DAY FROM trip_start_datetime) AS trip_day,
  EXTRACT(DAYOFWEEK FROM trip_start_datetime) AS trip_day_of_week,
  EXTRACT(HOUR FROM trip_start_datetime) AS trip_hour,

  trip_seconds,
  trip_miles,

  fare,
  tips,
  tolls,
  extras,
  trip_total,

  payment_type,
  
  COALESCE(company, 'Unknown') AS company,

  CASE
    WHEN taxi_id IS NULL THEN 'Unknown Taxi'

    ELSE CONCAT(
      COALESCE(company, 'Unknown'),
      ' - Taxi ',
      LPAD(
        CAST(
          DENSE_RANK() OVER (
            PARTITION BY COALESCE(company, 'Unknown')
            ORDER BY taxi_id
          ) AS STRING
        ),
        4,
        '0'
      )
    )
  END AS taxi_label,

  /*
    Fare anomaly detection derived from Bronze profiling.

    These rules identify combinations that were strongly abnormal
    in the source data:

    1. Missing fare
    2. Very high fare + very short trip
    3. Extremely high fare + short distance

    Records are flagged, not deleted, so source lineage is preserved.
  */

  CASE
    WHEN fare IS NULL THEN TRUE

    WHEN fare >= 1000
      AND trip_miles < 1
      AND trip_seconds < 1800
      THEN TRUE

    WHEN fare >= 5000
      AND trip_miles < 5
      THEN TRUE

    ELSE FALSE
  END AS fare_anomaly_flag,

  CASE
    WHEN fare IS NULL
      THEN 'MISSING_FARE'

    WHEN fare >= 1000
      AND trip_miles < 1
      AND trip_seconds < 1800
      THEN 'HIGH_FARE_SHORT_TRIP'

    WHEN fare >= 5000
      AND trip_miles < 5
      THEN 'EXTREME_FARE_SHORT_DISTANCE'

    ELSE NULL
  END AS fare_anomaly_reason,


  /*
    Duration plausibility flags (forensic review 2026-08-15).

    Records are flagged, never deleted, so lineage is preserved.
    Evidence (Bronze profiling): 98.9% of >12h records have implied
    speed < 3 mph (median 1.3 miles) — meter/device artifacts.

    Rules:
    1. IMPLAUSIBLE_SPEED — physically implausible: >= 2 hours at < 3 mph.
       Excluded from trusted Gold utilization analytics, retained here.
    2. ZERO_DURATION     — informational only.
    3. LONG_TRIP         — > 12 hours, informational only. A plausible
       long trip (>12h at reasonable speed) is retained everywhere and
       counts as activity; the 12h threshold is a chauffeur capacity
       limit (MCC §9-112-250), not a data-quality bound.
  */

  CASE
    WHEN trip_seconds >= 7200
      AND SAFE_DIVIDE(trip_miles, trip_seconds / 3600.0) < 3
      THEN TRUE
    ELSE FALSE
  END AS duration_plausibility_flag,

  CASE
    WHEN trip_seconds >= 7200
      AND SAFE_DIVIDE(trip_miles, trip_seconds / 3600.0) < 3
      THEN 'IMPLAUSIBLE_SPEED'
    WHEN trip_seconds = 0
      THEN 'ZERO_DURATION'
    WHEN trip_seconds > 43200
      THEN 'LONG_TRIP'
    ELSE NULL
  END AS duration_plausibility_reason,

  pickup_census_tract,
  dropoff_census_tract,

  pickup_community_area,
  dropoff_community_area,

  pickup_latitude,
  pickup_longitude,
  pickup_location,

  dropoff_latitude,
  dropoff_longitude,
  dropoff_location

-- FROM localized

-- WHERE trip_start_timestamp IS NOT NULL
--  AND trip_end_timestamp IS NOT NULL
--  AND trip_end_timestamp >= trip_start_timestamp

  -- Remove corrupted records
  -- AND trip_seconds IS NOT NULL

  -- Remove impossible trips (>24 hours)
  -- AND TIMESTAMP_DIFF(
        -- trip_end_timestamp,
        -- trip_start_timestamp,
        -- HOUR
      -- ) <= 24


FROM localized

WHERE trip_start_timestamp IS NOT NULL
AND trip_end_timestamp IS NOT NULL
AND trip_end_timestamp >= trip_start_timestamp

-- Remove corrupted records
AND trip_seconds IS NOT NULL

-- NOTE (forensic review 2026-08-15):
-- The previous hard delete "AND trip_seconds <= 43200" was removed.
-- Records >12h are retained and flagged via duration_plausibility_reason
-- ('IMPLAUSIBLE_SPEED' or 'LONG_TRIP'). Gold trusted analytics exclude
-- IMPLAUSIBLE_SPEED explicitly; Silver preserves full lineage.