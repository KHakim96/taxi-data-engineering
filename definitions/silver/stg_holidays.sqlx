config {
  type: "table",
  schema: "silver",
  name: "stg_holidays",
  description: "Standardized holiday data, one row per holiday_date"
}

SELECT
  CAST(holiday_date AS DATE) AS holiday_date,
  holiday_name,
  country,
  TRUE AS is_holiday
FROM ${ref("raw_holidays")}

-- dedup

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY CAST(holiday_date AS DATE)
  ORDER BY holiday_name
) = 1