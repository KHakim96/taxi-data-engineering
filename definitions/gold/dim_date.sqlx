config {
  type: "table",
  schema: "gold",
  name: "dim_date",
  description: "Date Dimension"
}

SELECT DISTINCT

  trip_date AS date_key,

  trip_year,

  trip_month,

  trip_day,

  trip_day_of_week,

  trip_hour,

  CASE
    WHEN trip_day_of_week IN (1, 7) THEN TRUE
    ELSE FALSE
  END AS is_weekend

FROM ${ref("stg_taxi_trips")}