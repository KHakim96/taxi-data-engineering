config {
  type: "table",
  schema: "gold",
  name: "fact_vehicle_activity_day",
  description: "Daily taxi activity and trip summary.",
}

WITH trusted AS (

  SELECT
    taxi_id,
    trip_start_datetime,
    trip_end_datetime_exact,
    trip_seconds,
    trip_miles,
    DATE(trip_start_datetime) AS trip_start_date
  FROM ${ref("stg_taxi_trips")}
  WHERE taxi_id IS NOT NULL
    AND trip_start_datetime IS NOT NULL
    AND trip_end_datetime_exact IS NOT NULL
    AND duration_anomaly_flag = FALSE
),

-- Merge overlapping trips into one timeline per taxi:
-- +1 at trip start, -1 at exact end. Running count > 0 = vehicle active.
events AS (

  SELECT taxi_id, trip_start_datetime AS t, 1 AS d
  FROM trusted
  WHERE trip_end_datetime_exact > trip_start_datetime

  UNION ALL

  SELECT taxi_id, trip_end_datetime_exact AS t, -1 AS d
  FROM trusted
  WHERE trip_end_datetime_exact > trip_start_datetime
),

points AS (
  SELECT taxi_id, t, SUM(d) AS d
  FROM events
  GROUP BY taxi_id, t
),

timeline AS (
  SELECT
    taxi_id,
    t,
    SUM(d) OVER (PARTITION BY taxi_id ORDER BY t) AS active_trips,
    LEAD(t) OVER (PARTITION BY taxi_id ORDER BY t) AS next_t
  FROM points
),

blocks AS (
  SELECT taxi_id, t AS start_t, next_t AS end_t, active_trips
  FROM timeline
  WHERE active_trips > 0
    AND next_t > t
),

-- Split blocks at midnight so each calendar day owns its own activity.
sliced AS (

  SELECT
    taxi_id,
    DATE_ADD(DATE(start_t), INTERVAL n DAY) AS activity_date,
    GREATEST(start_t, DATETIME_ADD(DATETIME(DATE(start_t)), INTERVAL n DAY)) AS slice_start,
    LEAST(end_t, DATETIME_ADD(DATETIME(DATE(start_t)), INTERVAL (n + 1) DAY)) AS slice_end,
    active_trips
  FROM blocks,
  UNNEST(GENERATE_ARRAY(0, DATE_DIFF(DATE(end_t), DATE(start_t), DAY))) AS n -- generate 1 row per day
),

-- Drop start time = the end time
day_slices AS (
  SELECT * FROM sliced WHERE slice_start < slice_end
),

per_day AS (

  SELECT
    taxi_id,
    activity_date,

    SUM(DATETIME_DIFF(slice_end, slice_start, SECOND)) AS active_seconds,
    MIN(slice_start) AS first_active,
    MAX(slice_end) AS last_active,
    MAX(active_trips) AS max_concurrent_trips, -- find overlaps trip

    -- for day/night flag (day_night_flag query)
    SUM(
      GREATEST(
        0,
        DATETIME_DIFF(
          LEAST(slice_end, DATETIME_ADD(DATETIME(activity_date), INTERVAL 17 HOUR)),
          GREATEST(slice_start, DATETIME_ADD(DATETIME(activity_date), INTERVAL 5 HOUR)),
          SECOND
        )
      )
    ) AS daytime_seconds

  FROM day_slices
  GROUP BY taxi_id, activity_date
),

trips_per_day AS (
  SELECT
    taxi_id,
    trip_start_date AS activity_date,
    COUNT(*) AS trip_count,
    SUM(trip_miles) AS trip_miles,
    MAX(trip_seconds) / 60.0 AS longest_trip_minutes
  FROM trusted
  GROUP BY taxi_id, activity_date
),

excluded_per_day AS (
  SELECT
    taxi_id,
    DATE(trip_start_datetime) AS activity_date,
    COUNT(*) AS implausible_records_excluded
  FROM ${ref("stg_taxi_trips")}
  WHERE taxi_id IS NOT NULL
    AND trip_start_datetime IS NOT NULL
    AND duration_anomaly_flag = TRUE
  GROUP BY taxi_id, activity_date
),

-- Every taxi-day with activity, trips, or excluded records
all_taxi_days AS (
  SELECT taxi_id, activity_date FROM per_day
  UNION DISTINCT
  SELECT taxi_id, activity_date FROM trips_per_day
  UNION DISTINCT
  SELECT taxi_id, activity_date FROM excluded_per_day
)

SELECT
  d.taxi_id,
  l.taxi_label,
  l.company,
  d.activity_date,

  ROUND(IFNULL(p.active_seconds, 0) / 60.0, 2) AS active_minutes,
  ROUND(IFNULL(p.active_seconds, 0) / 3600.0, 4) AS active_hours,

  IFNULL(t.trip_count, 0) AS trip_count,
  ROUND(IFNULL(t.trip_miles, 0), 2) AS trip_miles,
  ROUND(IFNULL(t.longest_trip_minutes, 0), 2) AS longest_single_trip_minutes,
  IFNULL(p.max_concurrent_trips, 0) AS max_concurrent_trips,
  IFNULL(e.implausible_records_excluded, 0) AS implausible_records_excluded,

  ROUND(
    IFNULL(DATETIME_DIFF(p.last_active, p.first_active, SECOND), 0) / 60.0,
    2
  ) AS elapsed_first_to_last_minutes,

  -- 12h = Chicago limit by law (based on web research)
  IFNULL(p.active_seconds, 0) > 43200 AS exceeds_single_driver_capacity,

  CASE
    WHEN p.active_seconds IS NULL THEN NULL
    WHEN IFNULL(p.daytime_seconds, 0) * 2 >= p.active_seconds THEN 'Day'
    ELSE 'Night'
  END AS day_night_flag

FROM all_taxi_days d
LEFT JOIN per_day p
  ON p.taxi_id = d.taxi_id AND p.activity_date = d.activity_date
LEFT JOIN trips_per_day t
  ON t.taxi_id = d.taxi_id AND t.activity_date = d.activity_date
LEFT JOIN excluded_per_day e
  ON e.taxi_id = d.taxi_id AND e.activity_date = d.activity_date

-- select taxi label n company
LEFT JOIN (
  SELECT taxi_id, ANY_VALUE(taxi_label) AS taxi_label, ANY_VALUE(company) AS company
  FROM ${ref("stg_taxi_trips")}
  WHERE taxi_id IS NOT NULL
  GROUP BY taxi_id
) l
  ON l.taxi_id = d.taxi_id
