config {
  type: "table",
  schema: "gold",
  name: "shift_summary",
  description: "Reconstructs vehicle operational blocks using an 8-hour inactivity boundary and a maximum 24-hour block window. Active trip hours are calculated from trip duration, excluding inactivity. Blocks exceeding 12 active trip hours are classified as Potential Overworker. Because the dataset has no driver identifier, this is a vehicle-level proxy and does not prove individual driver overtime."
}

WITH trip_starts AS (

    SELECT
        unique_key,
        taxi_id,
        taxi_label,
        company,

        trip_start_datetime,
        trip_end_datetime,

        trip_seconds,
        trip_total,

        DATETIME_DIFF(
            trip_start_datetime,
            LAG(trip_end_datetime) OVER (
                PARTITION BY taxi_id
                ORDER BY
                    trip_start_datetime,
                    trip_end_datetime,
                    unique_key
            ),
            MINUTE
        ) AS gap_minutes

    FROM ${ref("stg_taxi_trips")}

    WHERE taxi_id IS NOT NULL
),

initial_blocks AS (

    SELECT
        *,

        -- Start a new block when:
        -- 1. This is the first trip for the taxi, OR
        -- 2. The taxi has been inactive for at least 8 hours.
        IF(
            gap_minutes IS NULL
            OR gap_minutes >= 480,
            1,
            0
        ) AS is_new_block

    FROM trip_starts
),

session_ids AS (

    SELECT
        *,

        SUM(is_new_block) OVER (
            PARTITION BY taxi_id
            ORDER BY
                trip_start_datetime,
                trip_end_datetime,
                unique_key
        ) AS session_id

    FROM initial_blocks
),

session_start AS (

    SELECT
        *,

        MIN(trip_start_datetime) OVER (
            PARTITION BY taxi_id, session_id
        ) AS session_start_datetime

    FROM session_ids
),

bounded_blocks AS (

    SELECT
        *,

        -- Prevent a continuous session from becoming
        -- a multi-day or multi-month "shift".
        FLOOR(
            DATETIME_DIFF(
                trip_start_datetime,
                session_start_datetime,
                MINUTE
            ) / 1440
        ) AS block_sequence

    FROM session_start
),

block_metrics AS (

    SELECT
        taxi_id,

        ANY_VALUE(taxi_label) AS taxi_label,
        ANY_VALUE(company) AS company,

        session_id,
        block_sequence,

        MIN(trip_start_datetime) AS block_start_datetime,
        MAX(trip_end_datetime) AS block_end_datetime,

        -- Elapsed duration of the bounded block.
        ROUND(
            DATETIME_DIFF(
                MAX(trip_end_datetime),
                MIN(trip_start_datetime),
                MINUTE
            ) / 60.0,
            2
        ) AS block_duration_hours,

        -- Actual active trip time; gaps are excluded.
        ROUND(
            SUM(trip_seconds) / 3600.0,
            2
        ) AS active_trip_hours,

        COUNT(*) AS trips_in_block,

        SUM(trip_total) AS block_revenue

    FROM bounded_blocks

    GROUP BY
        taxi_id,
        session_id,
        block_sequence
)

SELECT
    taxi_id,
    taxi_label,
    company,

    CONCAT(
        CAST(session_id AS STRING),
        '-',
        CAST(block_sequence AS STRING)
    ) AS shift_id,

    block_start_datetime AS shift_start_datetime,
    block_end_datetime AS shift_end_datetime,

    block_duration_hours AS shift_duration_hours,

    active_trip_hours,

    trips_in_block AS trips_in_shift,

    block_revenue AS shift_revenue,

    CASE
        WHEN active_trip_hours > 12
            THEN 'Potential Overworker'
        ELSE 'Within 12-Hour Limit'
    END AS shift_classification

FROM block_metrics