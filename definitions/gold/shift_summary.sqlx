config {
  type: "table",
  schema: "gold",
  name: "shift_summary",
  description: "Reconstructs vehicle operational blocks by grouping trips for the same taxi_id when consecutive inactivity gaps are less than 8 hours. The 8-hour boundary is an analytical proxy informed by Chicago's statutory 8-hour rest requirement. Because the dataset does not contain a driver identifier, driver-level shifts cannot be directly measured. Blocks exceeding 12 active trip hours are classified as Potential Overworker."
}

WITH trip_starts AS (

    SELECT
        unique_key,
        taxi_id,
        taxi_label,
        company,

        trip_start_timestamp,
        trip_end_timestamp,

        trip_start_datetime,
        trip_end_datetime,

        trip_seconds,
        trip_total,

        -- Gap between the previous trip ending
        -- and the current trip starting.
        DATETIME_DIFF(
            trip_start_datetime,
            LAG(trip_end_datetime) OVER (
                PARTITION BY taxi_id
                ORDER BY
                    trip_start_datetime,
                    trip_end_datetime,
                    unique_key
            ),
            MINUTE
        ) AS gap_minutes

    FROM ${ref("stg_taxi_trips")}

    WHERE taxi_id IS NOT NULL
),

session_flags AS (

    SELECT
        *,

        -- Start a new vehicle operational block when:
        -- 1. This is the taxi's first trip, OR
        -- 2. The taxi has been inactive for at least 8 hours.
        --
        -- The 8-hour boundary is used as an analytical proxy
        -- informed by Chicago's statutory rest requirement.
        IF(
            gap_minutes IS NULL
            OR gap_minutes >= 480,
            1,
            0
        ) AS is_new_operational_block

    FROM trip_starts
),

block_ids AS (

    SELECT
        *,

        -- Assign a sequential operational block ID per taxi.
        SUM(is_new_operational_block) OVER (
            PARTITION BY taxi_id
            ORDER BY
                trip_start_datetime,
                trip_end_datetime,
                unique_key
        ) AS operational_block_id

    FROM session_flags
),

block_metrics AS (

    SELECT
        taxi_id,

        ANY_VALUE(taxi_label) AS taxi_label,
        ANY_VALUE(company) AS company,

        operational_block_id,

        MIN(trip_start_datetime) AS block_start_datetime,
        MAX(trip_end_datetime) AS block_end_datetime,

        -- Elapsed time from first trip start to last trip end.
        -- This includes inactivity/breaks within the block.
        ROUND(
            DATETIME_DIFF(
                MAX(trip_end_datetime),
                MIN(trip_start_datetime),
                MINUTE
            ) / 60.0,
            2
        ) AS block_duration_hours,

        -- Actual time spent on trips.
        -- Breaks between trips are excluded.
        ROUND(
            SUM(trip_seconds) / 3600.0,
            2
        ) AS active_trip_hours,

        COUNT(*) AS trips_in_block,

        SUM(trip_total) AS block_revenue

    FROM block_ids

    GROUP BY
        taxi_id,
        operational_block_id
)

SELECT
    taxi_id,
    taxi_label,
    company,

    operational_block_id AS shift_id,

    block_start_datetime AS shift_start_datetime,
    block_end_datetime AS shift_end_datetime,

    block_duration_hours AS shift_duration_hours,

    active_trip_hours,

    trips_in_block AS trips_in_shift,

    block_revenue AS shift_revenue,

    CASE
        WHEN active_trip_hours <= 12
            THEN 'Within 12-Hour Limit'

        WHEN active_trip_hours > 12
            THEN 'Potential Overworker'

    END AS shift_classification

FROM block_metrics