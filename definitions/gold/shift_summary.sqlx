config {
  type: "table",
  schema: "gold",
  name: "shift_summary",
  description: "Creates vehicle-level 24-hour operational windows from non-overlapping taxi activity intervals. Overlapping source trips are merged to prevent double-counting. Each operational window measures actual non-overlapping active time. Windows exceeding 12 active hours are classified as Potential Overworker. Because the dataset has no driver identifier, this is a vehicle-level proxy and does not prove individual driver overtime."
}

WITH trips AS (

  SELECT
    unique_key,
    taxi_id,
    taxi_label,
    company,
    trip_start_datetime,
    trip_end_datetime,
    trip_total

  FROM ${ref("stg_taxi_trips")}

  WHERE taxi_id IS NOT NULL
    AND trip_start_datetime IS NOT NULL
    AND trip_end_datetime IS NOT NULL
    AND trip_end_datetime > trip_start_datetime
),

-- =========================================================
-- 1. Create start/end events for every trip.
-- =========================================================

events AS (

  SELECT
    taxi_id,
    taxi_label,
    company,
    trip_start_datetime AS event_datetime,
    1 AS delta

  FROM trips

  UNION ALL

  SELECT
    taxi_id,
    taxi_label,
    company,
    trip_end_datetime AS event_datetime,
    -1 AS delta

  FROM trips
),

-- =========================================================
-- 2. Collapse events at the same timestamp.
-- =========================================================

event_points AS (

  SELECT
    taxi_id,
    ANY_VALUE(taxi_label) AS taxi_label,
    ANY_VALUE(company) AS company,
    event_datetime,
    SUM(delta) AS delta

  FROM events

  GROUP BY
    taxi_id,
    event_datetime
),

-- =========================================================
-- 3. Build a non-overlapping activity timeline.
-- =========================================================

coverage AS (

  SELECT
    taxi_id,
    taxi_label,
    company,
    event_datetime,

    SUM(delta) OVER (
      PARTITION BY taxi_id
      ORDER BY event_datetime
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS active_trip_count,

    LEAD(event_datetime) OVER (
      PARTITION BY taxi_id
      ORDER BY event_datetime
    ) AS next_event_datetime

  FROM event_points
),

active_intervals AS (

  SELECT
    taxi_id,
    taxi_label,
    company,

    event_datetime AS active_start_datetime,
    next_event_datetime AS active_end_datetime

  FROM coverage

  WHERE active_trip_count > 0
    AND next_event_datetime IS NOT NULL
    AND next_event_datetime > event_datetime
),

-- =========================================================
-- 4. Identify gaps between actual taxi activity.
--
-- 8 hours or more can still be treated as a new
-- operational session because it aligns with Chicago's
-- statutory rest requirement.
-- =========================================================

interval_gaps AS (

  SELECT
    *,

    DATETIME_DIFF(
      active_start_datetime,
      LAG(active_end_datetime) OVER (
        PARTITION BY taxi_id
        ORDER BY active_start_datetime
      ),
      MINUTE
    ) AS gap_minutes

  FROM active_intervals
),

session_flags AS (

  SELECT
    *,

    IF(
      gap_minutes IS NULL
      OR gap_minutes >= 480,
      1,
      0
    ) AS is_new_session

  FROM interval_gaps
),

sessions AS (

  SELECT
    *,

    SUM(is_new_session) OVER (
      PARTITION BY taxi_id
      ORDER BY active_start_datetime
    ) AS session_id

  FROM session_flags
),

session_starts AS (

  SELECT
    *,

    MIN(active_start_datetime) OVER (
      PARTITION BY taxi_id, session_id
    ) AS session_start_datetime

  FROM sessions
),

-- =========================================================
-- 5. Split activity exactly at 24-hour boundaries.
--
-- This is the important fix.
-- A 24-hour activity interval cannot spill into a
-- 48-hour block simply because its END is later.
-- =========================================================

window_numbers AS (

  SELECT
    s.*,
    window_number

  FROM session_starts s

  CROSS JOIN UNNEST(
    GENERATE_ARRAY(
      0,

      CAST(
        DIV(
          GREATEST(
            DATETIME_DIFF(
              s.active_end_datetime,
              s.session_start_datetime,
              MINUTE
            ) - 1,
            0
          ),
          1440
        ) AS INT64
      )
    )
  ) AS window_number
),

bounded_intervals AS (

  SELECT
    taxi_id,
    taxi_label,
    company,
    session_id,
    window_number,

    GREATEST(
      active_start_datetime,
      DATETIME_ADD(
        session_start_datetime,
        INTERVAL window_number * 24 HOUR
      )
    ) AS window_start_datetime,

    LEAST(
      active_end_datetime,
      DATETIME_ADD(
        session_start_datetime,
        INTERVAL (window_number + 1) * 24 HOUR
      )
    ) AS window_end_datetime

  FROM window_numbers
),

-- =========================================================
-- 6. Aggregate NON-OVERLAPPING active time.
-- =========================================================

window_metrics AS (

  SELECT
    taxi_id,

    ANY_VALUE(taxi_label) AS taxi_label,
    ANY_VALUE(company) AS company,

    session_id,
    window_number,

    MIN(window_start_datetime) AS shift_start_datetime,
    MAX(window_end_datetime) AS shift_end_datetime,

    ROUND(
      DATETIME_DIFF(
        MAX(window_end_datetime),
        MIN(window_start_datetime),
        MINUTE
      ) / 60.0,
      2
    ) AS shift_duration_hours,

    ROUND(
      SUM(
        DATETIME_DIFF(
          window_end_datetime,
          window_start_datetime,
          SECOND
        )
      ) / 3600.0,
      2
    ) AS active_trip_hours

  FROM bounded_intervals

  WHERE window_end_datetime > window_start_datetime

  GROUP BY
    taxi_id,
    session_id,
    window_number
)

SELECT
  taxi_id,
  taxi_label,
  company,

  CONCAT(
    CAST(session_id AS STRING),
    '-',
    CAST(window_number AS STRING)
  ) AS shift_id,

  shift_start_datetime,
  shift_end_datetime,

  shift_duration_hours,
  active_trip_hours,

  CASE
    WHEN active_trip_hours > 12
      THEN 'Potential Overworker'
    ELSE 'Within 12-Hour Limit'
  END AS shift_classification

FROM window_metrics