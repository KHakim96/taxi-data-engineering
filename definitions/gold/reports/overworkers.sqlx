config {
  type: "table",
  schema: "gold",
  name: "overworkers",
  description: "Daily vehicle utilization per taxi. Counts days exceeding 12h",
}

SELECT
  activity_date,

  taxi_id,
  taxi_label,
  company,

  CASE
    WHEN exceeds_single_driver_capacity THEN 1
    ELSE 0
  END AS days_exceeding_single_driver_capacity,

  active_hours AS total_active_hours,
  active_hours AS max_daily_active_hours,
  active_hours AS avg_daily_active_hours,

  trip_miles AS total_trip_miles,
  trip_count,

  longest_single_trip_minutes,
  max_concurrent_trips,
  implausible_records_excluded,

  exceeds_single_driver_capacity,
  day_night_flag

FROM ${ref("fact_vehicle_activity_day")}
