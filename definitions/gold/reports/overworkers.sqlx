config {
  type: "table",
  schema: "gold",
  name: "overworkers",
  description: "Aggregates taxi shift data to identify potential overworkers. Since the dataset does not have driver identifiers, we use taxi_id. Shifts are categorized into Normal, Overworker, and Shared Vehicle Fleet based on their duration to isolate single-driver behavior from 24/7 fleet operations."
}

SELECT
    DATE(shift_start_datetime) AS shift_date,
    taxi_id,
    COUNT(*) AS total_shifts,
    COUNTIF(shift_classification = 'Normal') AS normal_shift_count,
    COUNTIF(shift_classification = 'Overworker') AS overworker_shift_count,
    COUNTIF(shift_classification = 'Shared Vehicle Fleet') AS shared_vehicle_shift_count,
    SUM(shift_duration_hours) AS total_shift_hours,
    MAX(shift_duration_hours) AS longest_shift_hours,
    SUM(trips_in_shift) AS total_trips,
    SUM(shift_revenue) AS total_revenue
FROM ${ref("shift_summary")}
GROUP BY 
    shift_date,
    taxi_id