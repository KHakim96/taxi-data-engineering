config {
  type: "table",
  schema: "gold",
  name: "overworkers",
  description: "Vehicle-Day Utilization report (name kept for Looker data-source compatibility). Aggregates gold.vehicle_activity_day at one row per taxi per activity date. All measures are VEHICLE-level utilization — this is NOT driver overtime: taxi_id is a medallion-level identifier, multiple drivers may share one vehicle, and no driver identity, driver hours, or rest compliance is claimed. In Looker, sum days_exceeding_single_driver_capacity over a date range to count vehicle-days beyond single-driver legal capacity (>12 active hours, the Chicago chauffeur limit per MCC 9-112-250)."
}

/*
  Grain: taxi_id × activity_date (per-day rows; Looker aggregates
  across the user-selected date range).

  Field contract:
  - days_exceeding_single_driver_capacity : 0/1 per day   -> SUM in Looker
  - total_active_hours                    : daily hours   -> SUM in Looker
  - max_daily_active_hours                : daily hours   -> MAX in Looker
  - avg_daily_active_hours                : daily hours   -> AVG in Looker
  - total_trip_miles / trip_count         : daily totals  -> SUM in Looker
*/

SELECT
  activity_date,

  taxi_id,
  taxi_label,
  company,

  IF(
    capacity_classification =
      'Exceeds single-driver legal capacity (multi-driver and/or overwork — indeterminate)',
    1,
    0
  ) AS days_exceeding_single_driver_capacity,

  active_hours AS total_active_hours,
  active_hours AS max_daily_active_hours,
  active_hours AS avg_daily_active_hours,

  trip_miles AS total_trip_miles,
  trip_count,

  longest_single_trip_minutes,
  max_concurrent_trips,
  implausible_records_excluded,

  capacity_classification,
  day_night_flag

FROM ${ref("vehicle_activity_day")}
