config {
  type: "table",
  schema: "gold",
  name: "overworkers",
  description: "Aggregates bounded vehicle operational blocks to identify potential overwork. The dataset does not contain driver identifiers, so taxi_id is used as a vehicle-level proxy. Blocks exceeding 12 active trip hours are classified as Potential Overworker."
}

SELECT
  DATE(shift_start_datetime) AS shift_date,

  taxi_id,

  ANY_VALUE(taxi_label) AS taxi_label,
  ANY_VALUE(company) AS company,

  COUNT(*) AS total_operational_blocks,

  COUNTIF(
    shift_classification = 'Within 12-Hour Limit'
  ) AS within_12_hour_block_count,

  COUNTIF(
    shift_classification = 'Potential Overworker'
  ) AS potential_overworker_block_count,

  SUM(active_trip_hours) AS total_active_trip_hours,

  MAX(active_trip_hours) AS longest_active_trip_hours,

  SUM(shift_duration_hours) AS total_elapsed_block_hours,

  MAX(shift_duration_hours) AS longest_elapsed_block_hours

FROM ${ref("shift_summary")}

GROUP BY
  shift_date,
  taxi_id