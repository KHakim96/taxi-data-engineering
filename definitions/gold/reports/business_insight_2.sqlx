config {
  type: "table",
  schema: "gold",
  name: "business_insight_2",
  description: "Taxi Company Performance"
}

SELECT
    trip_date,
    company,
    COUNT(*) AS total_trips,
    SUM(trip_total) AS total_revenue,
    SUM(fare) AS total_fare,
    SUM(tips) AS total_tips
FROM ${ref("fact_taxi_trip")}
WHERE company IS NOT NULL
GROUP BY
    trip_date,
    company