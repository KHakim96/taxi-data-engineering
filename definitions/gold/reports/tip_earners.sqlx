config {
  type: "table",
  schema: "gold",
  name: "tip_earners",
  description: "Daily tip performance by taxi for dynamic BI reporting."
}

SELECT
    trip_date,
    taxi_id,
    ANY_VALUE(taxi_label) AS taxi_label,
    company,
    SUM(tips) AS total_tips,
    SUM(trip_total) AS total_revenue,
    SUM(fare) AS total_fare,
    COUNT(*) AS trip_count
FROM ${ref("fact_taxi_trip")}
WHERE taxi_id IS NOT NULL
GROUP BY
    trip_date,
    taxi_id,
    taxi_label,
    company