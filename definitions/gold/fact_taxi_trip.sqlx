config {
  type: "table",
  schema: "gold",
  name: "fact_taxi_trip",
  description: "Taxi Trip Fact Table"
}

SELECT

  unique_key,

  taxi_id,

  taxi_label,

  trip_date,

  trip_seconds,

  trip_miles,

  fare,

  tips,

  tolls,

  extras,

  trip_total,

  payment_type,

  company,

  pickup_community_area,

  dropoff_community_area

FROM ${ref("stg_taxi_trips")}

WHERE fare_anomaly_flag = FALSE

-- Keep only non-anomalous trips for trusted Gold analytics.
-- Anomalies are flagged and retained in Silver for traceability.