config {
  type: "table",
  schema: "gold",
  name: "fact_taxi_trip",
  description: "Taxi Trip Fact Table"
}

SELECT

  unique_key,

  taxi_id,

  taxi_label,

  trip_date,

  trip_seconds,

  trip_miles,

  fare,

  tips,

  tolls,

  extras,

  trip_total,

  payment_type,

  company,

  pickup_community_area,

  dropoff_community_area

FROM ${ref("stg_taxi_trips")}

WHERE fare_anomaly_flag = FALSE

-- Keep only non-anomalous trips for trusted Gold analytics.
-- Anomalies are flagged and retained in Silver for traceability.

-- Trusted-data exclusion (forensic review 2026-08-15):
-- duration-implausible records (>= 2h at < 3 mph, meter/device
-- artifacts) are excluded from the trusted fact. Silver retains
-- them with duration_plausibility_reason = 'IMPLAUSIBLE_SPEED'
-- (the only case where duration_plausibility_flag = TRUE).
-- Written flag-based for NULL safety: rows with NULL reason
-- (normal records) must pass, which a bare
-- "reason != 'IMPLAUSIBLE_SPEED'" comparison would not do.
AND NOT COALESCE(duration_plausibility_flag, FALSE)