config {
  type: "assertion"
}

-- Invariants: active_minutes in [0, 1440], active <= elapsed span,
-- one row per taxi_id x activity_date, capacity flag never NULL.

SELECT *
FROM ${ref("fact_vehicle_activity_day")}
WHERE active_minutes < 0
   OR active_minutes > 1440
   OR active_minutes > elapsed_first_to_last_minutes
   OR exceeds_single_driver_capacity IS NULL
   OR taxi_id IS NULL
   OR activity_date IS NULL

UNION ALL

-- Grain violations: any taxi_id × activity_date appearing more than once.
SELECT
  * EXCEPT (row_count)
FROM (
    SELECT
      *,
      COUNT(*) OVER (
        PARTITION BY taxi_id, activity_date
      ) AS row_count
    FROM ${ref("fact_vehicle_activity_day")}
  )
WHERE row_count > 1
