config {
  type: "assertion"
}

-- >24h check applies only to unflagged records (flagged anomalies
-- are retained by design).

SELECT *
FROM ${ref("stg_taxi_trips")}
WHERE trip_start_timestamp IS NULL
   OR trip_end_timestamp IS NULL
   OR trip_end_timestamp < trip_start_timestamp
   OR trip_seconds IS NULL
   OR (
        duration_anomaly_reason IS NULL
        AND TIMESTAMP_DIFF(
              trip_end_timestamp,
              trip_start_timestamp,
              HOUR
            ) > 24
      )
